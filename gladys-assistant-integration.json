  "actions": [
    {
      "key": "search_stations",
      "label": {
        "en": "Find stations",
        "fr": "Chercher des stations",
        "de": "Stationen suchen",
        "es": "Buscar estaciones"
      },
      "description": {
        "en": "Lists gauges with their number, river, distance and current water level: around your house, by name, by river or by number.",
        "fr": "Liste les stations avec leur numéro, leur cours d'eau, leur distance et leur hauteur d'eau actuelle : autour de votre maison, par nom, par cours d'eau ou par numéro.",
        "de": "Listet Pegel mit Nummer, Gewässer, Entfernung und aktuellem Wasserstand auf: rund um dein Haus, nach Name, nach Gewässer oder nach Nummer.",
        "es": "Enumera las estaciones con su número, río, distancia y nivel actual: alrededor de su casa, por nombre, por río o por número."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "label": {
            "en": "What",
            "fr": "Quoi",
            "de": "Was",
            "es": "Qué"
          },
          "description": {
            "en": "Empty: around your house. Or a station name (Köln), a river (Rhein, Mosel), both (Rhein Bonn) or a gauge number.",
            "fr": "Vide : autour de votre maison. Ou un nom de station (Köln), un cours d'eau (Rhein, Mosel), les deux (Rhein Bonn) ou un numéro de station.",
            "de": "Leer: rund um dein Haus. Oder ein Stationsname (Köln), ein Gewässer (Rhein, Mosel), beides (Rhein Bonn) oder eine Pegelnummer.",
            "es": "Vacío: alrededor de su casa. O un nombre de estación (Köln), un río (Rhein, Mosel), ambos (Rhein Bonn) o un número de estación."
          },
          "placeholder": {
            "en": "e.g. Rhein",
            "fr": "ex. Rhein",
            "de": "z. B. Rhein",
            "es": "p. ej. Rhein"
          },
          "required": false
